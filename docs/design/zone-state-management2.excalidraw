    {
      "id": "keyissue-body",
      "type": "text",
      "x": 598.5940069547908,
      "y": 824.4355741487211,
      "width": 375,
      "height": 90,
      "strokeColor": "#991b1b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "text": "controllerStore is keyed differently per mode:\n  BLE   → controllerId  (UUID)\n  Cloud → mac  (AA:BB:CC:DD:EE:FF)\n\nAll callers must use storeKey from context,\nnever the raw route param id.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "version": 173,
      "versionNonce": 1024900778,
