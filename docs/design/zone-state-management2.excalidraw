    {
      "id": "cloudManager-body",
      "type": "text",
      "x": 73.8906195469259,
      "y": 182.47816827577242,
      "width": 255,
      "height": 150,
      "strokeColor": "#003d80",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "text": "Module singleton, keyed by mac\n\n• load() → GET /api/devices/:mac\n  → setZones() authoritative\n• startSSE() → EventSource\n  /api/devices/:mac/stream\n• pollStatus() every 10s\n• applyZoneUpdate()\n  guards pending→idle\n• state: {connecting, connected}\n• subscribers: Set<fn>",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "version": 19,
      "versionNonce": 1092403638,
      "index": "aA",
      "isDeleted": false,
      "strokeStyle": "solid",
      "angle": 0,
      "seed": 1,
      "groupIds": [
        "DlbNdrJDFiJyRrs1SMv8s"
      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1778790769845,
      "link": null,
      "locked": false,
      "containerId": null,
      "originalText": "Module singleton, keyed by mac\n\n• load() → GET /api/devices/:mac\n  → setZones() authoritative\n• startSSE() → EventSource\n  /api/devices/:mac/stream\n• pollStatus() every 10s\n• applyZoneUpdate()\n  guards pending→idle\n• state: {connecting, connected}\n• subscribers: Set<fn>",
      "autoResize": true,
      "lineHeight": 1.048951048951049
