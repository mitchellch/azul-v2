      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1778790768140,
      "link": null,
      "locked": false,
      "containerId": null,
      "originalText": "Module singleton, keyed by controllerId\n\n• doConnect() → BLE connect\n• subscribeToZoneData() B3 notify\n  → guarded by initialFetchDone\n  → setZones() + syncQueue()\n• get_zones after connect\n  → setZones() authoritative\n  → sets initialFetchDone=true\n• retry on disconnect (max 10)\n• state: {connecting, connected}\n• subscribers: Set<fn>",
      "autoResize": true,
