    {
      "id": "controllerStore-body",
      "type": "text",
      "x": 240.59911401455048,
      "y": 558.232502829417,
      "width": 275,
      "height": 210,
      "strokeColor": "#1b5e20",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "text": "Module singleton\ncache: Map<storeKey, ZoneData[]>\nqueue: Map<storeKey, zoneId[]>\n\nBLE key  = controllerId (UUID)\nCloud key = mac\n\n• setZones(key, zones[]) — full replace\n• patch(key, zoneId, status, runtime)\n• seed(key, zones[]) — no-op if exists\n• syncQueue(key) — remove non-pending\n• enqueue(key, zoneId)\n• dequeue(key, zoneId)\n• queuePosition(key, zoneId)\n• subscribe(key, fn) → unsubscribe fn\n• single setInterval tick — counts\n  down running zones, flips→idle",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "version": 361,
      "versionNonce": 1220934326,
      "index": "b02",
      "isDeleted": false,
      "strokeStyle": "solid",
      "angle": 0,
      "seed": 1,
      "groupIds": [
        "aCakLbL7oGcogppVpH8-E"
      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1778790772712,
      "link": null,
      "locked": false,
      "containerId": null,
      "originalText": "Module singleton\ncache: Map<storeKey, ZoneData[]>\nqueue: Map<storeKey, zoneId[]>\n\nBLE key  = controllerId (UUID)\nCloud key = mac\n\n• setZones(key, zones[]) — full replace\n• patch(key, zoneId, status, runtime)\n• seed(key, zones[]) — no-op if exists\n• syncQueue(key) — remove non-pending\n• enqueue(key, zoneId)\n• dequeue(key, zoneId)\n• queuePosition(key, zoneId)\n• subscribe(key, fn) → unsubscribe fn\n• single setInterval tick — counts\n  down running zones, flips→idle",
      "autoResize": true,
      "lineHeight": 0.9502262443438915
    },
