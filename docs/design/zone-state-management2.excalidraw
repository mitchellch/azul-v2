    {
      "id": "zonesScreen-body",
      "type": "text",
      "x": 232.49788282754253,
      "y": 1277.7552754484263,
      "width": 335,
      "height": 275,
      "strokeColor": "#7c2d12",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "text": "reads from context: zones, storeKey,\n  connected, execCommand, setZones\n\nTap idle zone:\n  controllerBusy? (from zones[])\n  YES → enqueue(storeKey, id)\n        setZones → pending\n  NO  → setZones → running\n  → execCommand('start_zone')\n  catch → dequeue + setZones→idle\n\nTap active zone:\n  dequeue(storeKey, id)\n  setZones → idle\n  → execCommand('stop_zone')\n\nStop All:\n  setZones all → idle\n  dequeue all\n  → execCommand('stop_all')\n\nRender:\n  running → countdown (formatRuntime)\n  pending → queuePosition(storeKey, id)\n            1→'Next'  N→'#N'",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "version": 862,
      "versionNonce": 1102428342,
      "index": "aX",
      "isDeleted": false,
      "strokeStyle": "solid",
      "angle": 0,
      "seed": 1,
      "groupIds": [
        "u3gFjNCSVMwDTItwM5dzw"
      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1778792108164,
      "link": null,
      "locked": false,
      "containerId": null,
      "originalText": "reads from context: zones, storeKey,\n  connected, execCommand, setZones\n\nTap idle zone:\n  controllerBusy? (from zones[])\n  YES → enqueue(storeKey, id)\n        setZones → pending\n  NO  → setZones → running\n  → execCommand('start_zone')\n  catch → dequeue + setZones→idle\n\nTap active zone:\n  dequeue(storeKey, id)\n  setZones → idle\n  → execCommand('stop_zone')\n\nStop All:\n  setZones all → idle\n  dequeue all\n  → execCommand('stop_all')\n\nRender:\n  running → countdown (formatRuntime)\n  pending → queuePosition(storeKey, id)\n            1→'Next'  N→'#N'",
      "autoResize": true,
      "lineHeight": 0.8461538461538461
    },
