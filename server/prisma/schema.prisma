generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(uuid())
  auth0Sub  String   @unique @map("auth0_sub")
  email     String   @unique
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  devices        Device[]
  orgsOwned      Organization[] @relation("OrgOwner")
  orgMemberships OrgMember[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Organizations
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  ownerId   String   @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")

  owner   User        @relation("OrgOwner", fields: [ownerId], references: [id])
  members OrgMember[]
  devices Device[]

  @@map("organizations")
}

model OrgMember {
  orgId  String @map("org_id")
  userId String @map("user_id")
  role   String // "admin" | "member"

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id])

  @@id([orgId, userId])
  @@map("org_members")
}

// ---------------------------------------------------------------------------
// Devices
// ---------------------------------------------------------------------------

// Devices that have published MQTT status but haven't been claimed by a user yet
model PendingDevice {
  mac         String   @id
  firmware    String?
  ipAddress   String?  @map("ip_address")
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @updatedAt @map("last_seen_at")

  @@map("pending_devices")
}

model Device {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  orgId          String?   @map("org_id")
  mac            String    @unique
  name           String    @default("Azul Controller")
  firmware       String?
  target         String    @default("main-controller")  // firmware target family — future values: "zone-extender", etc.
  ipAddress      String?   @map("ip_address")
  online         Boolean   @default(false)
  lastSeenAt     DateTime? @map("last_seen_at")
  configVersion  Int       @default(1) @map("config_version")
  lastConfigAck  Int?      @map("last_config_ack")
  createdAt      DateTime  @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id])
  org          Organization? @relation(fields: [orgId], references: [id])
  zones        Zone[]
  schedules    Schedule[]
  auditLog     AuditLog[]
  eventLog     EventLog[]
  otaStatuses  DeviceOtaStatus[]

  @@map("devices")
}

// ---------------------------------------------------------------------------
// Zones
// ---------------------------------------------------------------------------

model Zone {
  id       String  @id @default(uuid())
  deviceId String  @map("device_id")
  number   Int
  name     String  @default("")
  color    String?
  photoUrl String? @map("photo_url")

  device       Device        @relation(fields: [deviceId], references: [id])
  auditLog     AuditLog[]
  scheduleRuns ScheduleRun[]

  @@unique([deviceId, number])
  @@map("zones")
}

// ---------------------------------------------------------------------------
// Schedules
// ---------------------------------------------------------------------------

model Schedule {
  id        String   @id @default(uuid())
  deviceId  String   @map("device_id")
  uuid      String   @unique         // UUID assigned by controller firmware
  name      String
  startDate String   @map("start_date")   // "YYYY-MM-DD"
  endDate   String?  @map("end_date")
  active    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  device Device        @relation(fields: [deviceId], references: [id])
  runs   ScheduleRun[]

  @@map("schedules")
}

model ScheduleRun {
  id              String  @id @default(uuid())
  scheduleId      String  @map("schedule_id")
  zoneId          String? @map("zone_id")
  zoneNumber      Int     @map("zone_number")
  dayMask         Int     @map("day_mask")
  hour            Int
  minute          Int
  durationSeconds Int     @map("duration_seconds")
  intervalDays    Int     @default(1) @map("interval_days")

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  zone     Zone?    @relation(fields: [zoneId], references: [id])

  @@map("schedule_runs")
}

// ---------------------------------------------------------------------------
// Audit log (legacy — zone activations only)
// ---------------------------------------------------------------------------

model AuditLog {
  id              String   @id @default(uuid())
  deviceId        String   @map("device_id")
  zoneId          String?  @map("zone_id")
  zoneNumber      Int      @map("zone_number")
  startedAt       DateTime @map("started_at")
  durationSeconds Int      @map("duration_seconds")
  source          String   // "scheduler" | "manual_rest" | "manual_ble" | "manual_cli"

  device Device @relation(fields: [deviceId], references: [id])
  zone   Zone?  @relation(fields: [zoneId], references: [id])

  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Event log (partitioned — all event types)
// ---------------------------------------------------------------------------
// NOTE: Prisma doesn't support partitioned tables natively.
// The actual table is created via raw SQL in the migration as:
//   CREATE TABLE event_log (...) PARTITION BY RANGE (created_at);
// This model exists so Prisma client can query it. The migration
// uses `@@ignore` workaround — see migration SQL for details.

model EventLog {
  id        String   @id @default(uuid())
  deviceId  String   @map("device_id")
  category  String   // "zone" | "schedule" | "config" | "system"
  action    String   // "zone_start" | "zone_stop" | "schedule_create" | "schedule_update" | "schedule_delete" | "schedule_activate" | "schedule_deactivate" | "zone_rename" | "device_rename" | "error" | ...
  metadata  Json?    // event-specific payload (zone number, duration, schedule name, error message, etc.)
  createdAt DateTime @default(now()) @map("created_at")

  device Device @relation(fields: [deviceId], references: [id])

  @@index([deviceId, createdAt])
  @@index([createdAt])
  @@map("event_log")
}

// ---------------------------------------------------------------------------
// Firmware releases (OTA) — see docs/design/ota-implementation-plan.md
// ---------------------------------------------------------------------------

model FirmwareRelease {
  id           String   @id @default(uuid())
  version      String                                 // semver, e.g. "0.2.1"
  target       String                                 // "main-controller" for MVP
  filePath     String   @map("file_path")             // relative to server/uploads/, e.g. "firmware/0.2.1/main-controller.bin"
  sha256       String                                 // hex digest computed server-side
  size         Int                                    // bytes
  releaseNotes String?  @map("release_notes")
  createdAt    DateTime @default(now()) @map("created_at")

  otaStatuses DeviceOtaStatus[]

  @@unique([version, target])
  @@map("firmware_releases")
}

model DeviceOtaStatus {
  id          String    @id @default(uuid())
  deviceId    String    @map("device_id")
  releaseId   String    @map("release_id")
  version     String                                  // denormalized for quick lookup even if release is deleted
  status      String                                  // "pending" | "downloading" | "verifying" | "installing" | "complete" | "error" | "rolled_back"
  progress    Int       @default(0)                   // 0-100
  error       String?
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  device  Device          @relation(fields: [deviceId], references: [id])
  release FirmwareRelease @relation(fields: [releaseId], references: [id])

  @@index([deviceId, startedAt])
  @@map("device_ota_status")
}
