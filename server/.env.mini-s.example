# Azul API env for azul-server (192.168.1.219). Copy to server/.env ON THE BOX.
# DB + MQTT are localhost because docker-compose maps their ports to the host.
DATABASE_URL="postgresql://azul:azul@localhost:5432/azul"
MQTT_URL="mqtt://localhost:1883"
PORT=3000

# Auth0 (same tenant as dev)
AUTH0_DOMAIN=dev-cgrr5v7lsr3wbpcj.us.auth0.com
AUTH0_AUDIENCE=https://api.azul

# Firmware builds its OTA download URL from this — MUST be the box's LAN address,
# not the laptop. (Was http://192.168.1.153:3000 on the dev laptop.)
SERVER_PUBLIC_URL=http://192.168.1.219:3000
