{
  "info": {
    "name": "Azul API",
    "_postman_id": "azul-api-collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Azul irrigation system API — local development (localhost:3000).\n\nRequires an Auth0 M2M application authorized for the `https://api.azul` audience."
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-fetch M2M token if not already set or expired.",
          "// Uses pm.variables.get() which checks: environment > collection > globals",
          "const tokenExpiry = pm.variables.get('token_expiry');",
          "const now = Math.floor(Date.now() / 1000);",
          "if (tokenExpiry && now < parseInt(tokenExpiry)) return;",
          "",
          "pm.sendRequest({",
          "  url: pm.variables.get('auth0_domain') + '/oauth/token',",
          "  method: 'POST',",
          "  header: { 'Content-Type': 'application/json' },",
          "  body: {",
          "    mode: 'raw',",
          "    raw: JSON.stringify({",
          "      grant_type: 'client_credentials',",
          "      client_id: pm.variables.get('auth0_client_id'),",
          "      client_secret: pm.variables.get('auth0_client_secret'),",
          "      audience: 'https://api.azul'",
          "    })",
          "  }",
          "}, (err, res) => {",
          "  if (err) { console.error('Token fetch failed', err); return; }",
          "  const body = res.json();",
          "  pm.collectionVariables.set('token', body.access_token);",
          "  pm.collectionVariables.set('token_expiry', String(now + (body.expires_in || 3600) - 60));",
          "});"
        ]
      }
    }
  ],
  "variable": [
    { "key": "base_url",           "value": "http://localhost:3000/api" },
    { "key": "auth0_domain",       "value": "https://dev-cgrr5v7lsr3wbpcj.us.auth0.com" },
    { "key": "auth0_client_id",    "value": "PASTE_YOUR_M2M_CLIENT_ID_HERE" },
    { "key": "auth0_client_secret","value": "PASTE_YOUR_M2M_CLIENT_SECRET_HERE" },
    { "key": "mac",                "value": "AC:A7:04:26:60:D0" },
    { "key": "mac_b",              "value": "E8:F6:0A:85:4C:90" },
    { "key": "zone",               "value": "1" },
    { "key": "schedule_uuid",      "value": "" },
    { "key": "test_schedule_uuid", "value": "" },
