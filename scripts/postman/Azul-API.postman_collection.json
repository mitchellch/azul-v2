            },
            {
              "name": "2. Stop all on both controllers",
              "request": {
                "method": "POST",
                "url": { "raw": "{{base_url}}/devices/{{mac}}/zones/stop-all", "host": ["{{base_url}}"], "path": ["devices", "{{mac}}", "zones", "stop-all"] }
              },
              "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
                "pm.test('Controller A stopped', () => pm.response.to.have.status(200));"
              ]}}]
            },
            {
              "name": "3. Stop all on controller B",
              "request": {
                "method": "POST",
                "url": { "raw": "{{base_url}}/devices/{{mac_b}}/zones/stop-all", "host": ["{{base_url}}"], "path": ["devices", "{{mac_b}}", "zones", "stop-all"] }
