              "name": "4. Start zone 1 on controller B",
              "request": {
                "method": "POST",
                "url": { "raw": "{{base_url}}/devices/{{mac_b}}/zones/1/start", "host": ["{{base_url}}"], "path": ["devices", "{{mac_b}}", "zones", "1", "start"] },
