        {
          "name": "Multi-controller isolation",
          "item": [
            {
              "name": "1. Verify both controllers exist",
              "request": {
                "method": "GET",
                "url": { "raw": "{{base_url}}/devices", "host": ["{{base_url}}"], "path": ["devices"] }
              },
              "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "",
                "const devices = pm.response.json();",
                "const macA = pm.collectionVariables.get('mac');",
                "const macB = pm.collectionVariables.get('mac_b');",
                "",
                "pm.test('Controller A exists', () => {",
                "  pm.expect(devices.some(d => d.mac === macA)).to.be.true;",
