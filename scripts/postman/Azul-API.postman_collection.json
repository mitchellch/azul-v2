              "name": "5. Verify controller A zone 1 still idle",
              "request": {
                "method": "GET",
                "url": { "raw": "{{base_url}}/devices/{{mac}}", "host": ["{{base_url}}"], "path": ["devices", "{{mac}}"] }
              },
              "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "",
                "const zones = pm.response.json().zones;",
                "const z1 = zones.find(z => z.number === 1);",
                "",
                "pm.test('Controller A zone 1 is idle (not affected by controller B)', () => {",
                "  pm.expect(z1.status).to.eql('idle');",
                "});"
              ]}}]
            },
            {
              "name": "6. Verify controller B zone 1 is running",
              "request": {
                "method": "GET",
                "url": { "raw": "{{base_url}}/devices/{{mac_b}}", "host": ["{{base_url}}"], "path": ["devices", "{{mac_b}}"] }
              },
              "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "",
                "const zones = pm.response.json().zones;",
                "const z1 = zones.find(z => z.number === 1);",
                "",
                "pm.test('Controller B zone 1 is running', () => {",
                "  pm.expect(z1.status).to.be.oneOf(['running', 'pending']);",
